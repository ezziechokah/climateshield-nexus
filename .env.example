# Copy to .env for local development. Keep real credentials out of source control.
NODE_ENV=development
DATABASE_MODE=sqlite
DATABASE_PATH=./data/climateshield.sqlite
DATABASE_URL=
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:4000
TRUST_PROXY_HOPS=0
REDIS_URL=

# Open-Meteo forecast endpoint (public API, no API key; use the documented base URL).
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Optional local-only admin account for evaluation dashboard access.
DEVELOPMENT_ADMIN_EMAIL=
DEVELOPMENT_ADMIN_PASSWORD=

# Optional local SMTP recovery delivery. If unset, development exposes an explicit simulator token.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
RECOVERY_PUBLIC_ORIGIN=http://localhost:5173

# Optional provider base URL; adapter treats responses as historical records only.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Reserved for providers that are not configured in this build. These are currently unused.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
USSD_PROVIDER=
USSD_SERVICE_CODE=
USSD_WEBHOOK_SECRET=
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=