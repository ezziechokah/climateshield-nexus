{
  "name": "@climateshield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @climateshield/contracts --filter @climateshield/climate-engine build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "corepack pnpm --filter @climateshield/contracts --filter @climateshield/climate-engine build",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test:postgres": "vitest run --dir src",
    "start": "node dist/index.js",
    "pretypecheck": "corepack pnpm --filter @climateshield/contracts --filter @climateshield/climate-engine build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "corepack pnpm --filter @climateshield/contracts --filter @climateshield/climate-engine build",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@climateshield/climate-engine": "workspace:*",
    "@climateshield/contracts": "workspace:*",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}